# Configuración para levantar TODO el sistema con docker-compose.yml (raíz del repo).
# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El .env no se sube a GitHub (está en .gitignore).

# Base de datos. Si ya usaste docker/postgres, poné EXACTAMENTE los mismos valores
# que en docker/postgres/.env: la carpeta data ya fue creada con ese usuario y contraseña.
# Evitar @ : / en la contraseña: rompen la dirección de conexión de los microservicios.
POSTGRES_USER=lubricentro
POSTGRES_PASSWORD=lubricentro1234
POSTGRES_PORT=5433

# Clave para firmar y verificar los tokens JWT (mínimo 32 caracteres). La usan los
# tres microservicios. Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=reemplazar-por-una-clave-larga-y-aleatoria
JWT_EXPIRA_MINUTOS=60

# Administrador que ms-usuarios crea automáticamente al arrancar.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@lubricentro.com
ADMIN_PASSWORD=reemplazar-por-una-clave-segura
