# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El .env no se sube a GitHub (está en .gitignore).

# Entorno de ejecución: development | testing | production
FLASK_CONTEXT=development

# Usuario, contraseña y puerto deben coincidir con docker/postgres/.env
DEV_DATABASE_URI=postgresql+psycopg2://lubricentro:lubricentro1234@localhost:5433/usuarios_db

PUERTO=5001
